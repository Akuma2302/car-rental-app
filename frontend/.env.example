# Only needed when deploying. For local development (`npm run dev`),
# api.js already falls back to http://localhost:4000/api automatically.
#
# Set this in your hosting provider's dashboard (Netlify/Vercel: Site
# settings → Environment variables) to your deployed backend's URL, e.g.:
VITE_API_URL=https://car-rental-app-fxns.onrender.com/api