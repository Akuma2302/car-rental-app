PORT=4000
WHATSAPP_NUMBER=60172507341
BUSINESS_NAME=JarGo
OPEN_HOUR=7
CLOSE_HOUR=22

# The customer-facing site (frontend/) and the internal admin app (admin/)
CORS_ORIGIN=http://localhost:5173
ADMIN_CORS_ORIGIN=http://localhost:5174

# Postgres connection string. Get one free from Render (New -> PostgreSQL),
# Supabase, or Neon. Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Any long random string — used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Used ONCE to create the first admin login, only if no admin account exists
# yet. Change your password after first login; these env vars can then be
# left as-is (they're ignored once an admin_users row exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# For vehicle image uploads (admin app). See backend/SUPABASE_SETUP.md
# for how to create the bucket and where to find these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=car-images

# Pricing-tier thresholds, in hours. Below HALF_DAY charges the hourly
# rate; below FULL_DAY charges the flat half-day rate; at/above FULL_DAY
# charges the daily rate x number of days.
HALF_DAY_THRESHOLD_HOURS=12
FULL_DAY_THRESHOLD_HOURS=24

# AI Agent (Telegram): follows up with the admin when a booking has been
# "pending" too long. Create a bot via @BotFather (get TELEGRAM_BOT_TOKEN),
# then message @userinfobot to get your own numeric TELEGRAM_ADMIN_CHAT_ID.
# See backend/README.md "AI Agent" section for full setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Any long random string — generate the same way as JWT_SECRET above. Used
# both when registering the webhook (scripts/registerTelegramWebhook.js)
# and to verify incoming webhook calls really come from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# How long (hours) a booking can stay "pending" before the agent pings the
# admin about it.
AGENT_PENDING_HOURS=4
# Any long random string. Whoever triggers POST /api/agent/sweep (e.g. an
# external cron job) must send this as the X-Agent-Secret header.
AGENT_SWEEP_SECRET=
